{% extends 'base.html.twig' %}

{% block title %}Indisponibilités
{% endblock %}

{% block breadcrumb %}
	{{ parent() }}
	<span class="mx-1">></span>
	Enregistrement d'une indisponibilité
{% endblock %}

{% block body %}

	<section class="w-full mr-auto">
		<h1 class="text-[#1F384C] text-[26px] font-medium">
			Enregistrement d'une indisponibilité
		</h1>

		{{form_start(form)}}

		<div class="flex md:flex-row flex-col gap-3 mt-4">
			{% include "composants/form_champ_date.html.twig" with {
            'label': 'Date de début - champ obligatoire',
            'field': form.startDate,
        } %}

			{% include "composants/form_champ_date.html.twig" with {
            'label': 'Date de fin - champ obligatoire',
            'field': form.endDate
        } %}
		</div>

		<div class="flex flex-col gap-4 mt-4">
			{% include "composants/form_champ_text.html.twig" with {
            'label': 'Motif',
            'field': form.reason
        } %}
		</div>

		<div class="flex flex-col sm:flex-row gap-6 items-center pt-5">
			{% include 'composants/button.html.twig' with {
            label: 'Retour à la liste des indisponibilités',
            type: 'cancel',
            url: path('app_instructor_unaivibility', {'id': unaivibility.instructor.id})
        } %}

			{% include 'composants/button.html.twig' with {
            label: 'Enregistrer les informations',
            type: 'confirm'
        } %}
		</div>

		{{ form_end(form) }}
	</section>

{% endblock %}
